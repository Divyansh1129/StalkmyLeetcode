# MongoDB Atlas connection (required for shared, durable app data)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Admin controls (required to add/remove players and edit app settings)
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional event integrations
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TIMEZONE=Asia/Kolkata

# Optional web push alerts; generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Scheduled-sync authorization
CRON_SECRET=replace-with-a-long-random-secret
